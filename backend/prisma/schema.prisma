// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Compatible with Prisma v5 (plain JavaScript project)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────────────────────────
// Product Catalogue
// ─────────────────────────────────────────────

model Product {
  id               String            @id @default(cuid())
  name             String
  brand            String?
  category         String?
  imageUrl         String?
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  merchantListings MerchantListing[]

  @@map("products")
}

model Store {
  id               String            @id @default(cuid())
  name             String
  domain           String            @unique
  country          String?
  logoUrl          String?
  createdAt        DateTime          @default(now())
  merchantListings MerchantListing[]

  @@map("stores")
}

// ─────────────────────────────────────────────
// Listings & Price History
// ─────────────────────────────────────────────

/// Maps a specific store URL to a master Product.
/// This is the bridge between an abstract product concept
/// and its concrete listing on a specific merchant's website.
model MerchantListing {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// The canonical URL of this product listing on the store
  url       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prices    Price[]

  @@index([productId])
  @@index([storeId])
  @@map("merchant_listings")
}

/// Append-only historical price log. Never update rows — always INSERT.
model Price {
  id        String          @id @default(cuid())
  listingId String
  listing   MerchantListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Numeric price value (stored as Decimal for accuracy)
  price     Decimal         @db.Decimal(12, 2)
  currency  String          @default("USD")
  inStock   Boolean         @default(true)
  /// Timestamp when this price was observed by the scraper
  scrapedAt DateTime        @default(now())

  @@index([listingId, scrapedAt(sort: Desc)])
  @@map("prices")
}
